# Copy this file to .env and fill in real values.
# On Render / Railway / AWS / Heroku, set these as Environment Variables in the service dashboard

NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/HRMS

JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# AI / Gemini API Key (Optional, for Resume Screening)
AI_API_KEY=

# Office IP Whitelisting (Optional, comma-separated IPs or CIDR blocks)
OFFICE_IPS=
